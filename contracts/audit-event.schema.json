{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-event.schema.json",
  "title": "Audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "source",
    "retention",
    "redaction",
    "actor",
    "action",
    "target",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "MAJOR must be 1; consumers tolerate higher MINOR"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "event_type": {
      "type": "string",
      "const": "audit_event"
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp_utc"
    },
    "request_id": {
      "type": "string",
      "maxLength": 128
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/hex_trace"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "retention": {
      "$ref": "common.schema.json#/$defs/retention"
    },
    "redaction": {
      "$ref": "common.schema.json#/$defs/redaction"
    },
    "extensions": {
      "type": "object",
      "description": "Framework-specific data; must not contain sensitive values"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,63}$"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied"
      ]
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "description": "Field names only, never values"
    },
    "client_ip": {
      "$ref": "common.schema.json#/$defs/ip"
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
